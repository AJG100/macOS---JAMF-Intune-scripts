#!/bin/bash

# Variables
DMG_NAME="cisco-secure-client-macos-5.1.17.3394-predeploy-k9.dmg"
MOUNT_POINT="/tmp/CiscoSecureClient"
CACHED_PKG="/Library/Application Support/JAMF/Waiting Room/$DMG_NAME"

# Debug - verify file exists
echo "Looking for DMG at: $CACHED_PKG"
ls -la "/Library/Application Support/JAMF/Waiting Room/"

# Mount the DMG
hdiutil attach "$CACHED_PKG" -mountpoint "$MOUNT_POINT" -nobrowse -quiet

# Verify mount worked
if [ ! -d "$MOUNT_POINT" ]; then
    echo "ERROR: DMG failed to mount"
    exit 1
fi

# Install the pkg
installer -pkg "$MOUNT_POINT/Cisco Secure Client.pkg" -target / -verbose

# Copy all Profiles to Cisco directory
mkdir -p /opt/cisco/secureclient/
cp -R "$MOUNT_POINT/Profiles/" /opt/cisco/secureclient/

# Unmount the DMG
hdiutil detach "$MOUNT_POINT" -quiet

exit 0
